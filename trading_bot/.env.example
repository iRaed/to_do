# ===== EXECUTION MODE =====
# MODE controls broker selection: paper | live
MODE=paper
# Hard gate. Must be the literal string "true" to allow real orders.
LIVE_TRADING=false
# Third gate. Must ALSO be "true" before live trading is allowed to start.
# This is intentional friction. If it is missing or false, the bot refuses to start in live mode.
I_UNDERSTAND_THIS_CAN_LOSE_MONEY=false

# ===== EXCHANGE =====
EXCHANGE=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Use Binance spot testnet when MODE=live if true.
BINANCE_TESTNET=true

# ===== MARKETS =====
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=5m

# ===== ACCOUNT / RISK =====
ACCOUNT_EQUITY=1000
RISK_PER_TRADE=0.03
MAX_RISK_PER_TRADE=0.05
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=0.10
MAX_CONSECUTIVE_LOSSES=4
MAX_TRADES_PER_DAY=10

# Hard caps on individual order and daily traded notional (USDT).
MAX_ORDER_NOTIONAL_USDT=250
MAX_DAILY_NOTIONAL_USDT=1000

# ===== STRATEGY EXITS =====
STOP_LOSS_PCT=0.025
TP1_PCT=0.03
TP2_PCT=0.06
TRAILING_STOP_PCT=0.015
COOLDOWN_MINUTES=30

# ===== STRATEGY ENTRY =====
VOLUME_MULTIPLIER=1.5
BREAKOUT_LOOKBACK=20

# ===== EXECUTION COSTS =====
PAPER_SLIPPAGE_PCT=0.001
MIN_NOTIONAL_USDT=10
TAKER_FEE_PCT=0.001

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEARTBEAT_HOURS=6

# ===== WEBHOOKS / COMMAND ENDPOINT =====
TRADINGVIEW_WEBHOOK_SECRET=
# Shared secret for POST /command (status|kill|positions). Distinct from
# the TradingView secret so you can rotate them independently.
COMMAND_SECRET=

# ===== KILL SWITCH =====
KILL_SWITCH_CLOSE_POSITIONS=false

# ===== LOOP =====
LOOP_INTERVAL_SECONDS=60

# ===== DATABASE / LOGS =====
DB_PATH=./data/trading_bot.db
LOG_LEVEL=INFO
